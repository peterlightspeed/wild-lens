ENVIRONMENT=development
# Generate a real value with: openssl rand -hex 32
# Never reuse the dev placeholder below in production.
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Local Docker Compose default — fine as-is for local dev (see
# docker-compose.yml). Point at your real host/user/password in production.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/wildlens
# Comma-separated list of frontend origins allowed to call this API.
# Replace YOUR-USERNAME with your real GitHub Pages username/org (or swap
# this whole value for your custom domain / Vercel / Netlify URL).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://peterlightspeed.github.io
REDIS_URL=redis://localhost:6379/0

# Used by app/services/storage.py for image uploads (sightings, studio).
# Leave blank to disable Cloudinary uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# NOTE: these three are declared in app/core/config.py but not read
# anywhere else in the codebase as of this conversion — identify() now
# uses the GROQ_API_KEY/GEMINI_API_KEY chain below instead, and the studio
# image/video tools (generate, upscale, bg-remove, image-to-video) are
# still client-side simulated, not wired to a real provider. Safe to
# delete once you've confirmed nothing else references them, or repurpose
# if you wire the Studio tools to a real image/video API later.
VISION_API_KEY=
IMAGE_GEN_API_KEY=
VIDEO_GEN_API_KEY=

# Multi-provider AI fallback chain for /api/chat and /api/identify.
# Leave any blank to skip that provider — the chain falls through to the
# next one, and finally to a mock so the app still runs with none set.
# Verify current free-tier limits before relying on these in production.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

GUEST_DAILY_CHAT_LIMIT=15
USER_DAILY_CHAT_LIMIT=100
